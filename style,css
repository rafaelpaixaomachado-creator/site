/* ==========================================================================
   1. CONFIGURAÇÕES GERAIS E RESET
   ========================================================================== */
* {
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Arial, sans-serif;
    background: #f0f4f8;
    margin: 0;
    padding: 40px 20px;
    color: #1f2937;
}

/* ==========================================================================
   2. ESTRUTURA DO FORMULÁRIO
   ========================================================================== */
form {
    max-width: 640px;
    margin: 0 auto;
    background: #ffffff;
    padding: 32px 40px 40px;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
}

h1 {
    font-size: 1.5rem;
    color: #0f172a;
    margin-bottom: 4px;
}

p.subtitle {
    color: #64748b;
    margin-top: 0;
    margin-bottom: 28px;
    font-size: 0.95rem;
}

fieldset {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 16px 20px 20px;
    margin-bottom: 20px;
}

legend {
    font-weight: 600;
    color: #334155;
    padding: 0 8px;
}

/* ==========================================================================
   3. CAMPOS DE ENTRADA (INPUTS, SELECTS E TEXTAREA)
   ========================================================================== */
label, 
.group-legend {
    display: block;
    margin-top: 14px;
    margin-bottom: 6px;
    font-weight: 500;
    font-size: 0.9rem;
    color: #334155;
}

input[type="text"], 
input[type="email"], 
input[type="tel"], 
input[type="date"], 
input[type="number"], 
select, 
textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 0.95rem;
    font-family: inherit;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

/* Efeito de foco suave nos campos */
input:focus, 
select:focus, 
textarea:focus {
    outline: none;
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
}

textarea {
    resize: vertical;
    min-height: 90px;
}

/* ==========================================================================
   4. COMPONENTES (RADIO BUTTONS E CHECKBOXES)
   ========================================================================== */
.radio-group, 
.checkbox-group {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 8px;
}

.radio-group label, 
.checkbox-group label {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    font-weight: 400;
    font-size: 0.92rem;
    cursor: pointer;
}

.radio-group input, 
.checkbox-group input {
    width: auto;
    accent-color: #2563eb; /* Aplica a cor azul nativamente nos seletores */
}

/* ==========================================================================
   5. BOTÕES E AUXILIARES
   ========================================================================== */
button {
    margin-top: 24px;
    width: 100%;
    padding: 12px;
    background: #2563eb;
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease;
}

button:hover {
    background: #1d4ed8;
}

.obrigatorio {
    color: #dc2626;
}
